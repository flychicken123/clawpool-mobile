{
    "expo":  {
                 "name":  "MyAI-pocket openclaw agent",
                 "slug":  "clawpool",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/icon.png",
                 "userInterfaceStyle":  "dark",
                 "splash":  {
                                "image":  "./assets/splash-icon.png",
                                "resizeMode":  "contain",
                                "backgroundColor":  "#0F0F1A"
                            },
                 "ios":  {
                             "buildNumber":  "3",
                             "bundleIdentifier":  "com.clawpool.app",
                             "supportsTablet":  true,
                             "infoPlist":  {
                                               "ITSAppUsesNonExemptEncryption":  false,
                                               "NSCameraUsageDescription": "MyAI-pocket openclaw agent uses your camera to let you take photos for your profile picture or to share images with your AI assistant during conversations.",
                                               "NSPhotoLibraryUsageDescription": "MyAI-pocket openclaw agent uses your photo library so you can choose an existing photo for your profile picture or share images with your AI assistant during conversations. For example, you can select a photo from your library to set as your avatar."
                                           },
                             "usesAppleSignIn": true,
                             "entitlements":  {
                                               "com.apple.developer.applesignin": ["Default"]
                                             }
                         },
                 "android":  {
                                 "versionCode":  1,
                                 "predictiveBackGestureEnabled":  false,
                                 "adaptiveIcon":  {
                                                      "monochromeImage":  "./assets/android-icon-monochrome.png",
                                                      "backgroundColor":  "#0F0F1A",
                                                      "backgroundImage":  "./assets/android-icon-background.png",
                                                      "foregroundImage":  "./assets/android-icon-foreground.png"
                                                  },
                                 "package":  "com.clawpool.app"
                             },
                 "web":  {
                             "favicon":  "./assets/favicon.png"
                         },
                 "plugins":  [
                                "expo-apple-authentication"
                             ],
                 "scheme":  "clawpool",
                 "extra":  {
                               "eas":  {
                                           "projectId":  "9c1faa92-10d6-4f2f-93a6-be3e38bf400a"
                                       }
                           },
                 "owner":  "flychicken"
             }
}
